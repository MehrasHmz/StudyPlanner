@model StudyPlanner.Application.DTOs.StudySessionDto
@{ ViewData["Title"] = "Planned session"; var ordered = Model.Items.OrderBy(item => item.Order).ToList(); }
<div class="container">
    <header class="page-heading"><div><div class="eyebrow">Your study plan</div><h1>One session, clear priorities.</h1></div><a class="btn btn-outline-secondary" asp-action="Index"><i class="bi bi-arrow-left" aria-hidden="true"></i>Back</a></header>
    <section class="session-overview" aria-label="Session overview"><div><span class="text-muted">Available</span><strong>@Model.AvailableMinutes min</strong></div><div><span class="text-muted">Planned</span><strong>@Model.TotalPlannedMinutes min</strong></div><div><span class="text-muted">Items</span><strong>@Model.TotalPlannedItems</strong></div><div><span class="text-muted">Status</span><strong>@Model.Status</strong></div></section>
    @if (ordered.Any())
    {
        <form asp-action="CompleteSession" method="post" data-confirm="Complete this session with the recorded results?">
            <input type="hidden" name="SessionId" value="@Model.Id" />
            @for (var index = 0; index < ordered.Count; index++)
            {
                var item = ordered[index];
                <section class="session-result"><div class="section-title"><h3>@item.Order. @item.StudyItemTitle</h3><a class="icon-button" asp-controller="Focus" asp-action="Index" asp-route-itemId="@item.StudyItemId" title="Focus on @item.StudyItemTitle" aria-label="Focus on @item.StudyItemTitle"><i class="bi bi-bullseye" aria-hidden="true"></i></a></div>
                    <input type="hidden" name="Results[@index].StudyItemId" value="@item.StudyItemId" />
                    <div class="session-result-fields"><div><label class="form-label" for="minutes-@index">Minutes studied</label><input id="minutes-@index" type="number" name="Results[@index].MinutesSpent" value="@item.PlannedMinutes" min="1" required class="form-control" /></div><div><label class="form-label" for="score-@index">Score (optional)</label><input id="score-@index" type="number" name="Results[@index].Score" min="0" max="1" step="0.01" class="form-control" /></div><div><label class="form-label" for="notes-@index">Notes (optional)</label><input id="notes-@index" name="Results[@index].Notes" class="form-control" maxlength="1000" /></div></div>
                </section>
            }
            <button class="btn btn-primary mt-4" type="submit"><i class="bi bi-check-circle" aria-hidden="true"></i>Complete session</button>
        </form>
    }
    else { <div class="empty-state"><i class="bi bi-calendar d-block" aria-hidden="true"></i><h3>No items fit this session.</h3><div class="page-actions justify-content-center"><a class="btn btn-primary" asp-controller="StudyItems" asp-action="Create">Add study item</a><a class="btn btn-outline-secondary" asp-action="Index">Change duration</a></div></div> }
</div>
