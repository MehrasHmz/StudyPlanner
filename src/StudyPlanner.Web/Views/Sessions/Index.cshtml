@model StudyPlanner.Web.Models.PlanSessionViewModel
@{ ViewData["Title"] = "Session planner"; }
<div class="container">
    <header class="page-heading"><div><div class="eyebrow">Make a plan</div><h1>Your next study session</h1></div><a class="btn btn-outline-primary" asp-controller="Focus" asp-action="Index"><i class="bi bi-bullseye" aria-hidden="true"></i>Open Focus</a></header>
    <section class="planner-form">
        <form asp-action="Plan" method="post"><div class="py-4">
            <h2 class="mb-4">How much time do you have?</h2>
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <label asp-for="AvailableMinutes" class="form-label"></label><div class="input-group"><input asp-for="AvailableMinutes" type="number" class="form-control" min="1" max="480" required aria-describedby="durationError" /><span class="input-group-text">min</span></div>
            <span asp-validation-for="AvailableMinutes" id="durationError" class="text-danger d-block mb-4" role="alert"></span>
            <button class="btn btn-primary" type="submit"><i class="bi bi-calendar-plus" aria-hidden="true"></i>Plan session</button>
        </div></form>
    </section>
</div>
