@model StudyPlanner.Web.Models.FocusViewModel
@{ ViewData["Title"] = "Focus"; ViewData["FocusMode"] = true; }
@section Styles { <link rel="stylesheet" href="~/css/focus.css" asp-append-version="true" /> }
<section id="focusExperience" class="focus-experience" data-initial-task="@Model.SelectedTask" data-entry-item="@Model.SelectedItemId">
    <header class="focus-toolbar"><a class="navbar-brand" asp-controller="Home" asp-action="Index"><span class="brand-logo" aria-hidden="true"></span>StudyPlanner<span class="focus-label">Focus</span></a><div class="focus-toolbar-actions"><button type="button" id="themeToggle" class="icon-button" title="Switch theme" aria-label="Switch theme"><i id="themeIcon" class="bi bi-sun" aria-hidden="true"></i></button><button type="button" id="fullscreenButton" class="icon-button" title="Enter fullscreen" aria-label="Enter fullscreen"><i class="bi bi-fullscreen" aria-hidden="true"></i></button><a class="icon-button" asp-controller="Home" asp-action="Index" title="Exit Focus Mode" aria-label="Exit Focus Mode"><i class="bi bi-x-lg" aria-hidden="true"></i></a></div></header>
    <div class="focus-stage">
        <div class="focus-kicker"><span class="focus-status-dot"></span><span id="focusStatus" role="status" aria-live="polite">Ready</span></div>
        <h1>Let's Focus Together</h1><p class="focus-subtitle">One task. One moment. Your full attention.</p>
        <div class="focus-task"><h2 id="activeTask">A little focused time</h2><button type="button" id="editTaskButton" class="icon-button" aria-label="Edit current task" title="Edit current task"><i class="bi bi-pencil" aria-hidden="true"></i></button></div>
        <fieldset class="timer-modes"><legend class="visually-hidden">Timer mode</legend><label><input type="radio" name="timerMode" value="countdown" checked /><span><i class="bi bi-hourglass" aria-hidden="true"></i>Countdown</span></label><label><input type="radio" name="timerMode" value="stopwatch" /><span><i class="bi bi-stopwatch" aria-hidden="true"></i>Stopwatch</span></label></fieldset>
        <div id="timerDisplay" class="focus-timer" role="timer" aria-live="off" aria-label="Remaining focus time">00:25:00</div>
        <progress id="focusProgress" class="focus-progress" value="0" max="1500000" aria-label="Countdown progress"></progress>
        <fieldset id="durationControls" class="duration-controls"><legend class="visually-hidden">Countdown duration</legend><div class="duration-presets" role="group" aria-label="Duration presets"><button type="button" data-duration="25" aria-pressed="true">25 min</button><button type="button" data-duration="50" aria-pressed="false">50 min</button><button type="button" data-duration="90" aria-pressed="false">90 min</button></div><label class="custom-duration" for="customMinutes">Custom <input id="customMinutes" type="number" min="1" max="480" step="1" value="25" /> min</label></fieldset>
        <div class="focus-controls"><button type="button" id="startPauseButton" class="btn btn-primary"><i class="bi bi-play-fill" aria-hidden="true"></i><span>Start focus</span></button><button type="button" id="resetButton" class="icon-button" aria-label="Reset timer" title="Reset timer"><i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i></button></div>
        <p id="completionMessage" class="focus-completion" hidden>Great work. Your focus session is complete.</p><p id="focusNotice" class="focus-notice" role="status" aria-live="polite"></p>
    </div>
    <footer class="focus-footer"><span>Local focus time <span aria-hidden="true">/</span> Study progress unchanged</span><div><label class="clock-toggle"><input id="showClock" type="checkbox" checked /> Show clock</label><time id="localClock"></time></div></footer>
    <dialog id="taskDialog" aria-labelledby="taskDialogTitle"><h2 id="taskDialogTitle">What deserves your attention?</h2><form id="taskForm" method="dialog"><div class="mb-3"><label class="form-label" for="studyItemSelect">Study item</label><select id="studyItemSelect" class="form-select"><option value="">Custom task</option>@foreach (var item in Model.Items) { <option value="@item.Id">@item.Title</option> }</select></div><div class="mb-4"><label class="form-label" for="taskTitle">Task title</label><input id="taskTitle" class="form-control" maxlength="200" required /></div><div class="form-actions"><button type="submit" class="btn btn-primary">Save task</button><button type="button" class="btn btn-outline-secondary" id="cancelTaskButton">Cancel</button></div></form></dialog>
</section>
@section Scripts { <script src="~/js/focus-timer.js" asp-append-version="true"></script><script src="~/js/focus.js" asp-append-version="true"></script> }
