@{ var focus = ViewData["FocusMode"] is true; var authenticated = User.Identity?.IsAuthenticated ?? false; var controller = ViewContext.RouteData.Values["controller"]?.ToString(); }
<!DOCTYPE html>
<html lang="en" data-bs-theme="dark" data-theme="dark">
<head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - StudyPlanner</title>
    <link rel="icon" type="image/svg+xml" href="~/logo.svg" asp-append-version="true" />
    <script src="~/js/theme.js" asp-append-version="true"></script>
    <link rel="stylesheet" href="~/vendor/bootstrap-5.3.3/bootstrap.min.css" />
    <link rel="stylesheet" href="~/vendor/bootstrap-icons-1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="@(focus ? "focus-page" : "")" data-user-id="@User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value">
    <a class="skip-link" href="#main-content">Skip to content</a>
    @if (!focus)
    {
        <nav class="navbar navbar-expand-xl" aria-label="Main navigation" id="mainNav"><div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index"><span class="brand-logo" aria-hidden="true"></span>StudyPlanner</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav" aria-controls="nav" aria-expanded="false" aria-label="Toggle navigation"><i class="bi bi-list" aria-hidden="true"></i></button>
            <div class="collapse navbar-collapse" id="nav">
                @if (authenticated)
                {
                    <ul class="navbar-nav workspace-nav me-auto">
                        @foreach (var link in new[] { ("Home", "Dashboard", "grid-1x2"), ("StudyItems", "Study items", "journal-text"), ("Categories", "Categories", "tags"), ("Sessions", "Sessions", "calendar-check"), ("Focus", "Focus", "bullseye") })
                        { <li class="nav-item"><a class="nav-link" asp-controller="@link.Item1" asp-action="Index" aria-current="@(controller == link.Item1 ? "page" : null)"><i class="bi bi-@link.Item3" aria-hidden="true"></i><span>@link.Item2</span></a></li> }
                    </ul>
                }
                <ul class="navbar-nav nav-account-controls ms-auto align-items-lg-center">
                    <li class="nav-item"><button class="theme-toggle-btn" type="button" id="themeToggle" aria-label="Switch theme" title="Switch theme"><i class="bi bi-sun" id="themeIcon" aria-hidden="true"></i></button></li>
                    @if (authenticated)
                    {
                        <li class="nav-item dropdown"><button type="button" class="nav-link dropdown-toggle nav-user" data-bs-toggle="dropdown" aria-expanded="false"><i class="bi bi-person-circle" aria-hidden="true"></i><span class="nav-user-name">@User.Identity!.Name</span></button><ul class="dropdown-menu dropdown-menu-end"><li><form asp-controller="Auth" asp-action="Logout" method="post" data-logout><button class="dropdown-item" type="submit"><i class="bi bi-box-arrow-right me-2" aria-hidden="true"></i>Sign out</button></form></li></ul></li>
                    }
                    else
                    {
                        <li class="nav-item nav-auth-item">
                            <div class="nav-auth-actions">
                                <a class="btn btn-outline-secondary" asp-controller="Auth" asp-action="Login">Sign in</a>
                                <a class="btn btn-primary" asp-controller="Auth" asp-action="Register">Create account</a>
                            </div>
                        </li>
                    }
                </ul>
            </div>
        </div></nav>
    }
    <main id="main-content" class="site-main" tabindex="-1">
        @if (TempData["Success"] != null) { <div class="container mt-3"><div class="alert alert-success alert-dismissible fade show" role="status">@TempData["Success"]<button class="btn-close" type="button" data-bs-dismiss="alert" aria-label="Dismiss message"></button></div></div> }
        @if (TempData["Error"] != null) { <div class="container mt-3"><div class="alert alert-danger" role="alert" tabindex="-1" data-error-summary>@TempData["Error"]</div></div> }
        @RenderBody()
    </main>
    @if (!focus) { <footer class="site-footer"><div class="container d-flex justify-content-between flex-wrap gap-2"><span>StudyPlanner</span><span>&copy; @DateTime.Now.Year</span></div></footer> }
    <dialog id="confirmationDialog" aria-labelledby="confirmationTitle"><h2 id="confirmationTitle">Confirm action</h2><p id="confirmationMessage"></p><div class="form-actions"><button type="button" class="btn btn-primary" id="confirmAction">Confirm</button><form method="dialog"><button type="submit" class="btn btn-outline-secondary">Cancel</button></form></div></dialog>
    <script src="~/vendor/bootstrap-5.3.3/bootstrap.bundle.min.js"></script><script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
