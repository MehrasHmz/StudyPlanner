@model StudyPlanner.Application.Commands.StudyItems.CreateStudyItemCommand
@{
    ViewData["Title"] = "Create Study Item";
    var categories = ViewBag.Categories as List<CategoryDto> ?? new();
    var item = Model ?? new("", null, StudyPlanner.Domain.Enums.StudyItemType.Other, StudyPlanner.Domain.Enums.DifficultyLevel.Beginner, 30, 3, Guid.Empty, Guid.Empty, null);
    var fields = new StudyPlanner.Web.Models.StudyItemFormViewModel(item.Title, item.Description, item.Type, item.Difficulty, item.EstimatedDurationMinutes, item.Priority, item.CategoryId, item.NextReviewDate, categories);
}
<div class="container editor-page">
    <header class="page-heading"><div><div class="eyebrow">Your study plan</div><h1>Create Study Item</h1></div><a asp-action="Index" class="icon-button" title="Back to study items" aria-label="Back to study items"><i class="bi bi-arrow-left" aria-hidden="true"></i></a></header>
    <form asp-action="Create" method="post">
        <div asp-validation-summary="All" class="validation-summary" role="alert" tabindex="-1" data-error-summary></div>
        @if (ViewBag.Errors is List<string> errors && errors.Any() && ViewData.ModelState.IsValid) { <div class="alert alert-danger" role="alert">@string.Join(" ", errors)</div> }
        @await Html.PartialAsync("_FormFields", fields)
        <div class="editor-actions"><button type="submit" class="btn btn-primary"><i class="bi bi-plus-lg" aria-hidden="true"></i>Create Item</button><a asp-action="Index" class="btn btn-outline-secondary">Cancel</a></div>
    </form>
</div>
@section Scripts { <script src="~/js/study-forms.js" asp-append-version="true"></script> }
