@model StudyItemDto
@{
    ViewData["Title"] = "Edit Study Item";
    var categories = ViewBag.Categories as List<CategoryDto> ?? new();
    var fields = new StudyPlanner.Web.Models.StudyItemFormViewModel(Model.Title, Model.Description, Model.Type, Model.Difficulty, Model.EstimatedDurationMinutes, Model.Priority, Model.CategoryId, Model.NextReviewDate, categories);
}
<div class="container editor-page">
    <header class="page-heading"><div><div class="eyebrow">Your study plan</div><h1>Edit Study Item</h1></div><a asp-action="Index" class="icon-button" title="Back to study items" aria-label="Back to study items"><i class="bi bi-arrow-left" aria-hidden="true"></i></a></header>
    <form asp-action="Edit" method="post">
        <input asp-for="Id" type="hidden" />
        <div asp-validation-summary="All" class="validation-summary" role="alert" tabindex="-1" data-error-summary></div>
        @if (ViewBag.Errors is List<string> errors && errors.Any() && ViewData.ModelState.IsValid) { <div class="alert alert-danger" role="alert">@string.Join(" ", errors)</div> }
        @await Html.PartialAsync("_FormFields", fields)
        <div class="editor-actions"><button type="submit" class="btn btn-primary"><i class="bi bi-check-lg" aria-hidden="true"></i>Save Changes</button><a asp-action="Index" class="btn btn-outline-secondary">Cancel</a></div>
    </form>
</div>
@section Scripts { <script src="~/js/study-forms.js" asp-append-version="true"></script> }
