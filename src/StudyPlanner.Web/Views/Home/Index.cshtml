@model StudyPlanner.Application.DTOs.DashboardDto
@{ ViewData["Title"] = "Dashboard"; }
<div class="container">
    <header class="page-heading"><div><div class="eyebrow">Your workspace</div><h1>Good to see you, @User.Identity?.Name.</h1><p>@Model.DueForReview item@(Model.DueForReview == 1 ? "" : "s") due for review.</p></div><div class="page-actions"><a class="btn btn-outline-primary" asp-controller="Sessions" asp-action="Index"><i class="bi bi-calendar-plus" aria-hidden="true"></i>Plan session</a><a class="btn btn-primary" asp-controller="Focus" asp-action="Index"><i class="bi bi-bullseye" aria-hidden="true"></i>Open Focus</a></div></header>
    <section class="dashboard-metrics" aria-label="Study statistics">
        <div class="metric"><span class="metric-label"><i class="bi bi-journal-text" aria-hidden="true"></i>Study items</span><strong class="metric-value">@Model.TotalItems</strong></div>
        <div class="metric"><span class="metric-label"><i class="bi bi-check-circle" aria-hidden="true"></i>Completed</span><strong class="metric-value">@Model.CompletedItems</strong></div>
        <div class="metric"><span class="metric-label"><i class="bi bi-clock-history" aria-hidden="true"></i>Due for review</span><strong class="metric-value">@Model.DueForReview</strong></div>
        <div class="metric"><span class="metric-label"><i class="bi bi-stopwatch" aria-hidden="true"></i>Study minutes</span><strong class="metric-value">@Model.TotalMinutesStudied</strong></div>
    </section>
    <div class="dashboard-grid">
        <section aria-labelledby="recentHeading"><div class="section-title"><h2 id="recentHeading">Recent study items</h2><a asp-controller="StudyItems" asp-action="Index">View all <i class="bi bi-arrow-right" aria-hidden="true"></i></a></div>
            @if (Model.RecentItems.Any())
            {
                @foreach (var item in Model.RecentItems)
                { <div class="recent-item"><div><a class="recent-item-title" asp-controller="StudyItems" asp-action="Edit" asp-route-id="@item.Id">@item.Title</a><div class="item-meta"><span>@item.Type</span><span>@item.EstimatedDurationMinutes min</span><span class="badge bg-@(item.IsCompleted ? "success" : "secondary")">@(item.IsCompleted ? "Completed" : "Pending")</span></div></div><a class="icon-button" asp-controller="Focus" asp-action="Index" asp-route-itemId="@item.Id" title="Focus on @item.Title" aria-label="Focus on @item.Title"><i class="bi bi-play" aria-hidden="true"></i></a></div> }
            }
            else { <div class="empty-state"><i class="bi bi-journal-plus d-block" aria-hidden="true"></i><h3>A fresh start.</h3><a class="btn btn-primary" asp-controller="StudyItems" asp-action="Create">Add a study item</a></div> }
        </section>
        <aside><div class="section-title"><h2>Next steps</h2><span class="text-muted small">@Model.TotalSessions sessions</span></div><div class="action-list"><a asp-controller="StudyItems" asp-action="Create"><span><i class="bi bi-plus me-2" aria-hidden="true"></i>Add study item</span><i class="bi bi-arrow-up-right" aria-hidden="true"></i></a><a asp-controller="Sessions" asp-action="Index"><span><i class="bi bi-calendar-plus me-2" aria-hidden="true"></i>Plan a session</span><i class="bi bi-arrow-up-right" aria-hidden="true"></i></a><a asp-controller="Categories" asp-action="Index"><span><i class="bi bi-tags me-2" aria-hidden="true"></i>Manage categories</span><i class="bi bi-arrow-up-right" aria-hidden="true"></i></a></div><div class="focus-entry"><i class="bi bi-bullseye" aria-hidden="true"></i><h3>Make room for focus.</h3><a class="btn btn-outline-primary" asp-controller="Focus" asp-action="Index">Let's focus <i class="bi bi-arrow-right" aria-hidden="true"></i></a></div></aside>
    </div>
</div>
