@model CategoryDto
@{ ViewData["Title"] = "Edit Category"; }
<div class="container editor-page category-editor">
    <header class="page-heading"><div><div class="eyebrow">@(Model.UserId.HasValue ? "Your study library" : "Shared study library")</div><h1>Edit Category</h1></div><a asp-action="Index" class="icon-button" title="Back to categories" aria-label="Back to categories"><i class="bi bi-arrow-left" aria-hidden="true"></i></a></header>
    <form asp-action="Edit" method="post">
        <input asp-for="Id" type="hidden" />
        <div asp-validation-summary="All" class="validation-summary" role="alert" tabindex="-1" data-error-summary></div>
        @if (ViewBag.Errors is List<string> errors && errors.Any() && ViewData.ModelState.IsValid) { <div class="alert alert-danger" role="alert">@string.Join(" ", errors)</div> }
        @await Html.PartialAsync("_FormFields", new StudyPlanner.Web.Models.CategoryFormViewModel(Model.Name, Model.Description))
        <div class="editor-actions"><button type="submit" class="btn btn-primary"><i class="bi bi-check-lg" aria-hidden="true"></i>Save category</button><a asp-action="Index" class="btn btn-outline-secondary">Cancel</a></div>
    </form>
</div>
@section Scripts { <script src="~/js/study-forms.js" asp-append-version="true"></script> }
