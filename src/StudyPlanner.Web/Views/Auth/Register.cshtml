@{ ViewData["Title"] = "Create account"; }
<section class="auth-page"><div class="eyebrow">StudyPlanner</div><h1>Make time for learning.</h1><p class="text-muted">Create your workspace.</p>
    <form asp-action="Register" method="post">
        <div class="mb-3"><label class="form-label" for="registerName">Full name</label><input id="registerName" name="FullName" class="form-control" autocomplete="name" maxlength="200" required value="@ViewData["FullName"]" /></div>
        <div class="mb-3"><label class="form-label" for="registerEmail">Email address</label><input id="registerEmail" name="Email" class="form-control" type="email" autocomplete="username" maxlength="300" required value="@ViewData["Email"]" /></div>
        <div class="mb-4"><label class="form-label" for="registerPassword">Password</label><div class="password-field"><input id="registerPassword" name="Password" class="form-control" type="password" autocomplete="new-password" minlength="6" maxlength="100" required /><button class="icon-button" type="button" data-password-target="registerPassword" aria-label="Show password" aria-pressed="false" title="Show password"><i class="bi bi-eye" aria-hidden="true"></i></button></div></div>
        <button class="btn btn-primary w-100" type="submit">Create account <i class="bi bi-arrow-right" aria-hidden="true"></i></button>
    </form><p class="form-footer">Already have an account? <a asp-action="Login">Sign in</a></p>
</section>
