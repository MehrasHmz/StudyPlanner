# Copy to .env and replace POSTGRES_PASSWORD with a unique local password.
# .env is ignored by both Git and the Docker build context.
POSTGRES_USER=studyplanner
POSTGRES_PASSWORD=replace-with-a-unique-local-password
POSTGRES_DB=StudyPlanner
APP_PORT=8080
ASPNETCORE_ENVIRONMENT=Production
# Local loopback HTTP only. Require secure cookies for a TLS deployment.
REQUIRE_SECURE_COOKIES=false
LOGIN_ATTEMPTS_PER_MINUTE=10
REGISTRATION_ATTEMPTS_PER_MINUTE=5
